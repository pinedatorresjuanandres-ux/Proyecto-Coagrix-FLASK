# Copia este archivo como .env y ajusta los valores. Nunca subas el .env real
# (con contraseñas reales) a un repositorio.

# Base de datos MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=coagrix

# Flask
# development | production
FLASK_ENV=development
# 1 para activar el debugger de Flask (NUNCA en production)
FLASK_DEBUG=1
PORT=5000

# Genera una clave real con: python -c "import secrets; print(secrets.token_hex(32))"
# Obligatoria en producción; en development se usa una clave de desarrollo si falta.
SECRET_KEY=

# Backend de almacenamiento para el rate limiter de Flask-Limiter.
# En un solo servidor "memory://" basta; con varios workers/procesos usa Redis:
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://

# Correo saliente, usado por "Olvidé mi contraseña" para enviar el enlace
# de recuperación. Si se deja vacío, la app sigue funcionando: en
# development el enlace se muestra directamente en pantalla en lugar de
# enviarse por correo, para poder probar el flujo sin un SMTP real.
# Ejemplo con Gmail: crea una "contraseña de aplicación" en tu cuenta de
# Google y úsala en MAIL_PASSWORD (no tu contraseña normal).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
