<mxfile host="app.diagrams.net" agent="CoAgrix QA"><diagram name="Modelo MVC CoAgrix" id="9423912271"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Arquitectura Modelo-Vista-Controlador — CoAgrix" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#1E5631;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Actualizado al sistema implementado · revisión 25/11/2026" style="text;html=1;fontSize=11;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="600" height="20" as="geometry"/></mxCell><mxCell id="c3" value="Navegador del usuario&lt;br&gt;(Campesino, Empresa, Comerciante, Administrador)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#1565C0;fontColor=#FFFFFF;fontSize=14;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="280" height="70" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;app.py&lt;/b&gt; — punto de entrada&lt;br&gt;• Registra 11 Blueprints&lt;br&gt;• CSRF, sesión, límites&lt;br&gt;• Filtros (pesos COP) y páginas de error&lt;br&gt;Puerto 5000 (local) / Waitress (Render)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="400" y="100" width="300" height="120" as="geometry"/></mxCell><mxCell id="c5" value="CONTROLADOR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E5631;strokeColor=#1E5631;fontColor=#FFFFFF;fontSize=14;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="270" width="300" height="40" as="geometry"/></mxCell><mxCell id="c6" value="Controlador/&lt;br&gt;auth · farmer · company · merchant · product · cart · message · appointment · account · comment · admin&lt;br&gt;&lt;br&gt;Valida permisos por rol y propiedad (403), valida formularios y decide qué vista mostrar." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="400" y="310" width="300" height="190" as="geometry"/></mxCell><mxCell id="c7" value="MODELO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E5631;strokeColor=#1E5631;fontColor=#FFFFFF;fontSize=14;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="270" width="300" height="40" as="geometry"/></mxCell><mxCell id="c8" value="Modelo/&lt;br&gt;user · product · order · message · appointment · farmer · company · merchant · review · favorite · comment · password_reset · admin · ubicaciones&lt;br&gt;&lt;br&gt;database.py: query_db / execute_db con consultas parametrizadas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="800" y="310" width="300" height="190" as="geometry"/></mxCell><mxCell id="c9" value="VISTA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E5631;strokeColor=#1E5631;fontColor=#FFFFFF;fontSize=14;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="280" height="40" as="geometry"/></mxCell><mxCell id="c10" value="Vista/ (Jinja2)&lt;br&gt;base.html, index, login, registro, catálogo, detalle, carrito, mensajes, farmer/, company/, merchant/, admin/, account/, errors/&lt;br&gt;&lt;br&gt;static/: css, js, img, uploads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="280" height="190" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;MySQL / MariaDB&lt;/b&gt;&lt;br&gt;24 tablas: usuarios, roles, campesinos, empresas, comerciantes, ubicaciones, publicaciones, productos, categorias, pedidos, detalle_pedidos, mensajes, citas, notificaciones, reseñas, favoritos, comentarios, password_resets, historial_precios, archivos…" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=15;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="300" width="280" height="210" as="geometry"/></mxCell><mxCell id="e12" value="1. Petición HTTP" style="endArrow=block;endFill=1;html=1;strokeColor=#444444;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="2. Ruta → Blueprint" style="endArrow=block;endFill=1;html=1;strokeColor=#444444;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="3. Solicita datos" style="endArrow=block;endFill=1;html=1;strokeColor=#444444;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="4. Consulta SQL" style="endArrow=block;endFill=1;html=1;strokeColor=#444444;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="5. Resultado" style="endArrow=open;endFill=1;html=1;strokeColor=#444444;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c11" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1320" y="560"/><mxPoint x="950" y="560"/></Array></mxGeometry></mxCell><mxCell id="e17" value="6. Datos" style="endArrow=open;endFill=1;html=1;strokeColor=#444444;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c8" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="600"/><mxPoint x="550" y="600"/></Array></mxGeometry></mxCell><mxCell id="e18" value="7. render_template" style="endArrow=block;endFill=1;html=1;strokeColor=#444444;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c6" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="8. HTML al navegador" style="endArrow=block;endFill=1;html=1;strokeColor=#444444;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c10" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="Corrección: se retiró la tabla «Transporte» (no existe; es un campo de publicaciones) y los archivos inexistentes campesino_controller.py, interaccion_controller.py y catalogo_controller.py." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="560" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>