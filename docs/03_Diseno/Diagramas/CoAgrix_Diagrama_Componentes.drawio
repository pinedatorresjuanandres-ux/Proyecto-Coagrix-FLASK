32;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="390" y="860" width="330" height="70" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Sesiones&lt;/b&gt;&lt;br&gt;.flask_session_data/" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="390" y="960" width="330" height="60" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;MySQL / MariaDB&lt;/b&gt;&lt;br&gt;Local: XAMPP (3306)&lt;br&gt;Nube: Aiven&lt;br&gt;24 tablas" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="640" width="220" height="140" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Google Apps Script (HTTPS)&lt;/b&gt;&lt;br&gt;o servidor SMTP&lt;br&gt;Correo de recuperación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1560" y="820" width="220" height="80" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;Render (plan gratuito)&lt;/b&gt;&lt;br&gt;render.yaml · waitress-serve&lt;br&gt;Disco no persistente: uploads y sesiones se pierden al reiniciar (RSK-03)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1560" y="940" width="260" height="100" as="geometry"/></mxCell><mxCell id="e48" value="HTTP/HTTPS (formularios con token CSRF)" style="endArrow=open;endSize=10;html=1;strokeColor=#444444;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e49" value="fetch JSON" style="endArrow=open